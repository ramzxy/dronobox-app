{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci --ignore-scripts",
    "buildCommand": "npm run build",
    "outputDirectory": "src/dist",
    "headers": [
        {
            "source": "/sw.js",
            "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
    ]
}
